{
  "expo": {
    "name": "Smart Finance",
    "slug": "smart-finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartfinance",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kavishka.smartfinance"
    },
    "android": {
      "package": "com.kavishka.smartfinance",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "##1e293b"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Smart Finance to use Face ID to unlock your account."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7b449aa2-5041-4cf4-b44b-a68951c32cb9"
      }
    },
    "owner": "kavishka_disanayaka"
  }
}
