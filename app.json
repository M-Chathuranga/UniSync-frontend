{
  "expo": {
    "name": "Smart Finance",
    "slug": "smart-finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartfinance",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kavishka.smartfinance"
    },
    "android": {
      "package": "com.kavishka.smartfinance",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Smart Finance to use Face ID to unlock your account."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "711a5972-c7b8-4c13-b314-94b99d81d5c1"
      }
    }
  }
}